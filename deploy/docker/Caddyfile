# FrankenPHP in classic (per-request) mode — no worker mode, so no state can
# leak between tenants' requests (docs/adr/0006-no-octane-for-now.md).
{
	frankenphp
	auto_https off
	admin off
}

:{$PORT:8080} {
	root * /app/public
	encode zstd gzip

	# Hashed SPA assets never change: cache them forever.
	@spaAssets path /app/assets/*
	header @spaAssets Cache-Control "public, max-age=31536000, immutable"

	# Serves existing files, otherwise routes to public/index.php.
	php_server
}
