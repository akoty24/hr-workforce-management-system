# On-premises configuration. Copy to .env and edit. Never commit the real file.

APP_NAME="HR Workforce"
APP_ENV=production
APP_DEBUG=false
# Generate with: docker compose run --rm --no-deps app php artisan key:generate --show
APP_KEY=
# The address people use to open the system:
APP_URL=http://hr.example.local:8080
HTTP_PORT=8080

DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=hr_workforce
DB_USERNAME=hr_workforce
DB_PASSWORD=change-me-strong-password
MYSQL_ROOT_PASSWORD=change-me-another-strong-password

# One company per installation.
TENANCY_RESOLVER=single

SESSION_DRIVER=database
# Set to true when the system is served over HTTPS (recommended).
SESSION_SECURE_COOKIE=false
CACHE_STORE=database
QUEUE_CONNECTION=database

# Files: local volume by default. For S3/MinIO set FILESYSTEM_DISK=s3 and AWS_*.
FILESYSTEM_DISK=local

# Behind a reverse proxy / load balancer that terminates TLS, list it here (or *).
TRUSTED_PROXIES=

# Weekend days excluded from leave (ISO: 1=Mon ... 7=Sun). Default Fri+Sat.
HR_WEEKEND_DAYS=5,6

# Outgoing email (company SMTP server).
MAIL_MAILER=smtp
MAIL_HOST=smtp.example.local
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=hr@example.local
MAIL_FROM_NAME="${APP_NAME}"

LOG_CHANNEL=stderr
LOG_LEVEL=info
